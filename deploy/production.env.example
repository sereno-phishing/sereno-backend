# Production settings: copy to .env beside docker-compose.yml on the VM
# (cp deploy/production.env.example .env) and fill in. The real .env is
# Git-ignored; never commit it.

# Both compose files for every docker compose command run in this folder.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Public hostname: the Azure DNS label of the VM's public IP.
SERENO_DOMAIN=<label>.<region>.cloudapp.azure.com

# Required. Goes into DATABASE_URL, so keep it URL-safe: openssl rand -hex 24
# Applied only when the database volume is first created.
POSTGRES_PASSWORD=

# Optional, default "sereno".
#POSTGRES_USER=sereno
#POSTGRES_DB=sereno

# Optional: "0" serves every verdict from the model without cache.
#CACHE_ENABLED=1
